---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EditionCard from '../../components/EditionCard.astro';

const editions = (await getCollection('editions', (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="Editions" description="Every monthly edition of Midnight Technical Signals.">
  <div class="page-head">
    <p class="eyebrow">Archive</p>
    <h1>Editions</h1>
    <p>Every monthly issue of Midnight Technical Signals, newest first.</p>
  </div>

  <div class="editions-list">
    {
      editions.map((e) => (
        <EditionCard
          id={e.id}
          title={e.data.title}
          edition={e.data.edition}
          date={e.data.date}
          summary={e.data.summary}
          tags={e.data.tags}
        />
      ))
    }
  </div>
</Base>

<style>
  .page-head { padding-top: 2.5rem; margin-bottom: 2.5rem; }
  .page-head h1 { margin: 0.4rem 0 0.6rem; }
  .page-head p { color: var(--text-dim); margin: 0; }
  .editions-list { display: grid; gap: 1rem; }
</style>
