---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/path';
import { SITE } from '../../lib/site';
import { formatDate } from '../../lib/date';

export async function getStaticPaths() {
  const entries = await getCollection('editions', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const dateStr = formatDate(d.date);
const editFile = `${SITE.repo}/blob/main/src/content/editions/${entry.id}.md`;
---

<Base title={d.title} description={d.summary} image={d.cover ? withBase(d.cover) : undefined}>
  <article class="edition">
    <a class="edition__back" href={withBase('editions')}>← All editions</a>

    <header class="edition__header">
      <p class="eyebrow">{d.edition}</p>
      <h1>{d.title}</h1>
      <p class="edition__lede">{d.summary}</p>
      <div class="edition__meta">
        <time datetime={d.date.toISOString()}>{dateStr}</time>
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    {
      d.cover && (
        <img class="edition__cover" src={withBase(d.cover)} alt={`${d.edition} cover`} loading="eager" />
      )
    }

    <div class="prose">
      <Content />
    </div>

    <footer class="edition__footer">
      <p>
        Found an error or something out of date?
        <a href={editFile} target="_blank" rel="noopener">Edit this edition on GitHub ↗</a>
      </p>
      <a class="btn" href={withBase('contribute')}>Contribute a signal</a>
    </footer>
  </article>
</Base>

<style>
  .edition { padding-top: 2.5rem; }
  .edition__back {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .edition__header { margin: 1.5rem 0 2rem; }
  .edition__header h1 { margin: 0.4rem 0 0; }
  .edition__lede {
    font-size: 1.15rem;
    color: var(--text-dim);
    margin: 1rem 0 1.25rem;
  }
  .edition__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .edition__cover {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin: 0 0 2.5rem;
  }
  .edition__footer {
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .edition__footer a { color: var(--violet); }
  .edition__footer .btn { color: var(--text); margin-top: 1rem; }

  .prose :global(h2) {
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
  }
  .prose :global(h2:first-child) { border-top: 0; margin-top: 0; }
  .prose :global(a) {
    color: #c4a5ff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) { color: #fff; }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.3rem; }
  .prose :global(li) { margin: 0.4rem 0; }
  .prose :global(img) { border-radius: var(--radius); border: 1px solid var(--border); }
</style>
