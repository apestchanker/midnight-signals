---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EditionCard from '../components/EditionCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { withBase } from '../lib/path';
import { SITE } from '../lib/site';

const editions = (await getCollection('editions', (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const [latest, ...rest] = editions;

const news = (await getCollection('news', (n) => !n.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---

<Base wide>
  <Hero
    slot="hero"
    line1="Midnight"
    line2="Signals"
    blurb="Every month, the protocol, ledger, tooling and ecosystem changes that Midnight builders should have on their radar — archived, searchable, and open to contributions."
  />

  <div class="home">
    {
      latest && (
        <section class="home__section">
          <div class="home__head">
            <h2>Latest edition</h2>
            <a class="home__more" href={withBase('editions')}>All editions →</a>
          </div>
          <EditionCard
            id={latest.id}
            title={latest.data.title}
            edition={latest.data.edition}
            date={latest.data.date}
            summary={latest.data.summary}
            tags={latest.data.tags}
            featured
          />
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section class="home__section">
          <h2>Archive</h2>
          <div class="home__grid">
            {rest.map((e) => (
              <EditionCard
                id={e.id}
                title={e.data.title}
                edition={e.data.edition}
                date={e.data.date}
                summary={e.data.summary}
                tags={e.data.tags}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      news.length > 0 && (
        <section class="home__section">
          <div class="home__head">
            <h2>Community news feed</h2>
            <a class="home__more" href={withBase('news')}>Full feed →</a>
          </div>
          <div class="home__news">
            {news.map((n) => (
              <NewsCard
                id={n.id}
                title={n.data.title}
                date={n.data.date}
                source={n.data.source}
                category={n.data.category}
                summary={n.data.summary}
                submittedBy={n.data.submittedBy}
              />
            ))}
          </div>
        </section>
      )
    }

    <section class="home__cta">
      <h2>Spotted a signal?</h2>
      <p>
        A release, a protocol change, an ecosystem integration — if it matters to
        developers, add it. Contributions go through a pull request and become
        part of the archive and the next monthly edition.
      </p>
      <div class="home__cta-btns">
        <a class="btn btn--primary" href={withBase('contribute')}>How to contribute</a>
        <a
          class="btn"
          href={`${SITE.repo}/issues/new?template=news-submission.yml`}
          target="_blank"
          rel="noopener"
        >
          Submit via issue ↗
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .home { margin-top: 3.5rem; }
  .home__section { margin-bottom: 4rem; }
  .home__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .home__head h2,
  .home__section > h2 { margin: 0 0 1.4rem; }
  .home__more {
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--violet);
  }
  .home__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1rem;
  }
  .home__news { max-width: 46rem; }
  .home__cta {
    max-width: 46rem;
    padding: 2rem 2rem 2.25rem;
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: var(--radius);
    background: var(--grad-soft);
  }
  .home__cta h2 { margin: 0 0 0.5rem; }
  .home__cta p { color: var(--text-dim); }
  .home__cta-btns { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
</style>
