---
import { withBase } from '../lib/path';
import { CATEGORY_LABELS } from '../lib/site';
import { formatShort } from '../lib/date';

interface Props {
  id: string;
  title: string;
  date: Date;
  source: string;
  category: string;
  summary: string;
  submittedBy?: string;
}
const { id, title, date, source, category, summary, submittedBy } = Astro.props;
const dateStr = formatShort(date);
let host = '';
try { host = new URL(source).hostname.replace(/^www\./, ''); } catch { /* noop */ }
---

<article class="news-card" id={id}>
  <div class="news-card__head">
    <span class="tag">{CATEGORY_LABELS[category] ?? category}</span>
    <time datetime={date.toISOString()}>{dateStr}</time>
  </div>
  <h3 class="news-card__title">
    <a href={withBase(`news/${id}`)}>{title}</a>
  </h3>
  <p class="news-card__summary">{summary}</p>
  <div class="news-card__foot">
    <a href={source} target="_blank" rel="noopener">Source: {host || 'link'} ↗</a>
    {submittedBy && (
      <span class="news-card__by">
        via <a href={`https://github.com/${submittedBy}`} target="_blank" rel="noopener">@{submittedBy}</a>
      </span>
    )}
  </div>
</article>

<style>
  .news-card {
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--border);
  }
  .news-card__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  .news-card__title { margin: 0.6rem 0 0; font-size: 1.1rem; }
  .news-card__title a:hover { color: var(--violet); }
  .news-card__summary { margin: 0.5rem 0 0.75rem; color: var(--text-dim); font-size: 0.93rem; }
  .news-card__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .news-card__foot a:hover { color: var(--violet); }
</style>
