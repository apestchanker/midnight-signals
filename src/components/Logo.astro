---
import { withBase } from '../lib/path';

interface Props {
  height?: number;
}
const { height = 20 } = Astro.props;
// Official wordmark aspect ratio (4751 x 1030).
const width = Math.round(height * 4.612);
---

<img
  class="logo"
  src={withBase('brand/midnight-wordmark-white.png')}
  alt="Midnight"
  width={width}
  height={height}
  style={`height:${height}px`}
/>

<style>
  .logo {
    display: block;
    width: auto;
  }
</style>
