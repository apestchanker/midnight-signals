---
import { withBase } from '../lib/path';

interface Props {
  height?: number;
}
const { height = 20 } = Astro.props;
---

<span class="logo" style={`--h:${height}px`}>
  <img
    class="logo__img"
    src={withBase('brand/midnight-wordmark.svg')}
    alt="Midnight"
    width="120"
    height={height}
    onerror="this.style.display='none';this.nextElementSibling.hidden=false"
  />
  <span class="logo__fallback" hidden>Midnight</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; }
  .logo__img { display: block; height: var(--h); width: auto; }
  .logo__fallback {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(var(--h) * 0.95);
    letter-spacing: -0.01em;
    color: var(--text);
  }
</style>
