---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<span class="logo" style={`--s:${size}px`}>
  <svg viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
    <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2" />
    <circle cx="11" cy="16" r="1.9" fill="currentColor" />
    <rect x="17.5" y="9.5" width="3.6" height="3.6" rx="0.6" fill="currentColor" />
    <rect x="17.5" y="18.9" width="3.6" height="3.6" rx="0.6" fill="currentColor" />
  </svg>
  <span class="logo__word">midnight <span class="logo__sub">signals</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text);
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }
  .logo__sub {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
