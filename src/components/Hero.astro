---
import Pillars from './Pillars.astro';
import Logo from './Logo.astro';
import { withBase } from '../lib/path';

interface Props {
  kicker?: string;
  title: string;
  blurb?: string;
  portrait?: string;
}
const {
  kicker = 'Technical updates for developers',
  title,
  blurb,
  portrait = 'brand/portrait.png',
} = Astro.props;
---

<section class="hero">
  <div class="grid-floor"></div>
  <div class="wrap-wide hero__inner">
    <div class="hero__text">
      <div class="hero__lockup">
        <Logo height={20} />
        <span>{kicker}</span>
      </div>
      <h1 class="hero__title gradient-text">{title}</h1>
      {blurb && <p class="hero__blurb">{blurb}</p>}
      <Pillars />
    </div>

    {
      portrait && (
        <div class="hero__media">
          <img
            class="hero__portrait"
            src={withBase(portrait)}
            alt=""
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: radial-gradient(620px 300px at 84% 18%, rgba(123, 92, 255, 0.2), transparent 65%);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    padding: 2.75rem 1.25rem 2.5rem;
  }
  .hero__lockup {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .hero__lockup > span {
    padding-left: 0.85rem;
    border-left: 1px solid var(--border-strong);
  }
  .hero__title {
    font-size: clamp(2.4rem, 7vw, 4.25rem);
    font-weight: 700;
    line-height: 0.95;
    margin: 0.9rem 0 0;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .hero__blurb {
    max-width: 34rem;
    color: var(--text-dim);
    font-size: 1rem;
    margin: 1rem 0 1.5rem;
  }

  .hero__media {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }
  /* Soft halo so the (mostly black) portrait separates from the dark background. */
  .hero__media::before {
    content: '';
    position: absolute;
    right: -8%;
    top: 50%;
    width: 130%;
    aspect-ratio: 1;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(123, 92, 255, 0.28), transparent 62%);
    pointer-events: none;
  }
  .hero__portrait {
    position: relative;
    display: block;
    width: auto;
    height: auto;
    /* Capped by height so the portrait can never push page content down. */
    max-height: 300px;
    max-width: 32vw;
    object-fit: contain;
  }

  @media (max-width: 780px) {
    .hero__inner { grid-template-columns: 1fr; gap: 1rem; padding-top: 2.25rem; }
    /* Accent only — drop it on small screens so the fold stays text-first. */
    .hero__media { display: none; }
  }
</style>
